<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.DarHoney" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/honey_primary</item>
        <item name="colorPrimaryDark">@color/honey_primary_dark</item>
        <item name="colorSecondary">@color/honey_secondary</item>
        <item name="android:colorBackground">@color/honey_background</item>
        <item name="colorSurface">@color/honey_surface</item>
        <item name="colorOnPrimary">@color/honey_on_primary</item>
        <item name="colorOnSurface">@color/honey_on_surface</item>
        <item name="android:textColor">@color/honey_on_surface</item>
        <item name="android:textColorPrimary">@color/honey_on_surface</item>
        <item name="android:textColorHint">@color/honey_text_secondary</item>
        <item name="textInputStyle">@style/Widget.DarHoney.TextInputLayout</item>
        <item name="editTextStyle">@style/Widget.DarHoney.TextInputEditText</item>
        <item name="android:editTextStyle">@style/Widget.DarHoney.TextInputEditText</item>
        <item name="android:statusBarColor">@color/honey_primary_dark</item>
    </style>

    <style name="Theme.DarHoney" parent="Base.Theme.DarHoney" />

    <style name="Theme.DarHoney.ActionBar" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/honey_surface</item>
        <item name="colorPrimaryDark">@color/honey_primary_dark</item>
        <item name="colorSecondary">@color/honey_secondary</item>
        <item name="android:colorBackground">@color/honey_background</item>
        <item name="colorSurface">@color/honey_surface</item>
        <item name="colorOnSurface">@color/honey_on_surface</item>
        <item name="android:statusBarColor">@color/honey_primary_dark</item>
        <item name="android:windowActionBarOverlay">false</item>
        <item name="actionBarTheme">@style/ThemeOverlay.DarHoney.ActionBar</item>
    </style>

    <style name="ThemeOverlay.DarHoney.ActionBar" parent="ThemeOverlay.Material3.ActionBar">
        <item name="android:textColorPrimary">@color/honey_primary_dark</item>
        <item name="colorControlNormal">@color/honey_primary_dark</item>
        <item name="android:background">@color/honey_surface</item>
    </style>

    <style name="Widget.DarHoney.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/honey_surface</item>
        <item name="titleTextColor">@color/honey_primary_dark</item>
        <item name="navigationIconTint">@color/honey_primary_dark</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="TextAppearance.DarHoney.SectionTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/honey_primary_dark</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.DarHoney.TextInputEditText" parent="Widget.Material3.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/honey_on_surface</item>
        <item name="android:textColorHint">@color/honey_text_secondary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ThemeOverlay.DarHoney.TextInput" parent="ThemeOverlay.Material3.TextInputEditText.OutlinedBox">
        <item name="colorControlActivated">@color/honey_primary</item>
        <item name="android:textColor">@color/honey_on_surface</item>
        <item name="android:textColorHint">@color/honey_text_secondary</item>
    </style>

    <style name="Widget.DarHoney.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintTextColor">@color/honey_text_secondary</item>
        <item name="boxStrokeColor">@color/honey_primary</item>
        <item name="boxBackgroundColor">@color/honey_surface</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.DarHoney.TextInput</item>
        <item name="editTextStyle">@style/Widget.DarHoney.TextInputEditText</item>
    </style>

    <style name="Widget.DarHoney.RatingBar" parent="@style/Widget.AppCompat.RatingBar.Small">
        <item name="android:isIndicator">false</item>
        <item name="android:numStars">5</item>
        <item name="android:stepSize">1</item>
        <item name="android:progressTint">@color/honey_primary</item>
        <item name="android:secondaryProgressTint">@color/honey_star_empty</item>
        <item name="android:progressBackgroundTint">@color/honey_star_empty</item>
    </style>

    <style name="Widget.DarHoney.TextInputLayout.ExposedDropdownMenu" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="hintTextColor">@color/honey_text_secondary</item>
        <item name="boxStrokeColor">@color/honey_primary</item>
        <item name="boxBackgroundColor">@color/honey_surface</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.DarHoney.TextInput</item>
        <item name="endIconTint">@color/honey_primary_dark</item>
        <item name="editTextStyle">@style/Widget.DarHoney.TextInputEditText</item>
    </style>
</resources>
